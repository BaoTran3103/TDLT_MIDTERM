    <property name="styleSheet">
     <string notr="true">/* 1. Tiêu đề chính font Impact */
QLabel#label {
    color: #FFF8E7;
    font-family: &quot;Impact&quot;;
    font-size: 38pt;
}

/* 2. Các ô nhập liệu (QLineEdit) */
QLineEdit {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12pt;
    color: #2C3E50;
}

QLineEdit:focus {
    background-color: #FFFFFF;
    border: 2px solid #E67E22;
}

/* 3. Chữ GOAL và các nhãn khác */
QLabel {
    color: #FFFFFF;
    font-family: &quot;Impact&quot;;
    font-size: 20pt;
}

/* 4. Nút CALCULATE (Bo tròn, đổi màu nổi bật, chữ đậm) */
QPushButton {
    background-color: #E67E22;
    color: #FFFFFF;
    font-family: &quot;Impact&quot;;
    font-size: 20pt;
    border-radius: 15px;
    border: 2px solid #D35400;
}

/* Hiệu ứng khi rê chuột vào nút CALCULATE */
QPushButton:hover {
    background-color: #D35400;
}

/* Hiệu ứng khi bấm vào nút CALCULATE */
QPushButton:pressed {
    background-color: #BA4A00;
}</string>
