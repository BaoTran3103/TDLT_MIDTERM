  </property>
  <property name="styleSheet">
   <string notr="true">/* 1. TIÊU ĐỀ CHÍNH: Nâng cấp sang màu vàng nắng (Sun-gold) cực sang, không còn trắng nhách */
QLabel#label {
    color: #FFDC73; 
    font-family: &quot;Impact&quot;;
    font-size: 38pt;
}

/* 2. Thanh chữ chạy Marquee phía trên */
#runningLabel {
    background-color: rgba(20, 20, 20, 0.65);
    color: #F39C12;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
    font-weight: bold;
    border-radius: 8px;
    padding: 4px 10px;
}

/* 3. TẤT CẢ các ô nhập liệu bên trái (Có border rõ nét, chữ sắc không mờ) */
QLineEdit {
    background-color: rgba(255, 255, 255, 0.95);
    border: 2px solid #2C3E50;
    border-radius: 8px;
    padding: 5px 8px;
    font-size: 12pt;
    color: #1E272E;
}

QLineEdit:focus {
    background-color: #FFFFFF;
    border: 2.5px solid #E67E22;
}

/* Ô GOAL riêng biệt bên dưới */
QLineEdit#goalInput {
    background-color: rgba(230, 126, 34, 0.95);
    color: #FFFFFF;
    font-weight: bold;
    border: 2px solid #D35400;
}

/* Nhãn chữ GOAL */
QLabel {
    color: #FFF8E7;
    font-family: &quot;Impact&quot;;
    font-size: 18pt;
}

/* 4. KHUNG KẾT QUẢ DỰ BÁO BÊN PHẢI (Smart Result Box) */
QGroupBox {
    color: #FFF8E7;
    font-family: &quot;Impact&quot;;
    font-size: 16pt;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 12px;
    margin-top: 15px;
    background-color: rgba(0, 0, 0, 0.45);
    padding-top: 15px;
}

/* ĐÃ FIX: Chỉnh tiêu đề &quot;KẾT QUẢ DỰ BÁO&quot; cho khớp font Impact và màu vàng đồng bộ */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #FFDC73;
    font-family: &quot;Impact&quot;;
    font-size: 15pt;
}

/* Các nhãn chữ bên trong khung kết quả */
QGroupBox QLabel {
    color: #FFF8E7;
    font-family: &quot;Impact&quot;;
    font-size: 14pt;
    letter-spacing: 1px;
}

/* 5. NÚT CALCULATE: Giữ nguyên bản tuyệt đẹp không đụng chạm */
QPushButton {
    background-color: #E67E22;
    color: #FFFFFF;
    font-family: &quot;Impact&quot;;
    font-size: 16pt;
    border-radius: 12px;
    border: 2px solid #D35400;
}

QPushButton:hover {
    background-color: #D35400;
}
</string>
  </property>
