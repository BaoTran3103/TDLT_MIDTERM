    <property name="styleSheet">
     <string notr="true">QLabel#runninglabel {
    background-color: rgba(20, 20, 20, 0.45); /* Nền tối mờ sang trọng */
    color: #FFF8E7; /* Chữ màu kem nhạt đồng bộ với tiêu đề chính */
    font-family: &quot;Segoe UI&quot;, sans-serif; /* Font chữ hiện đại, thanh thoát */
    font-size: 11pt;
    font-weight: bold;
    border-radius: 12px; /* Bo tròn đều 2 đầu như viên thuốc */
    padding: 5px 15px;
    border: 1px solid rgba(255, 255, 255, 0.2); /* Viền sáng nhẹ tinh tế */
}</string>
