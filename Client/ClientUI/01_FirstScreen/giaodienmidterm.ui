    <property name="styleSheet">
     <string notr="true">/* 1. Các ô nhập liệu (Tên môn, Tín chỉ, GPA): Viền đậm rõ nét, bo góc mượt */
QLineEdit {
    background-color: rgba(255, 255, 255, 0.95); /* Nền trắng đục chắc chắn */
    border: 2px solid #2f3640; /* Viền xám đen đậm bản to, chống mờ hoàn toàn */
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13pt;
    color: #1e272e; /* Chữ gõ vào màu đen đậm sắc nét */
}

/* Hiệu ứng khi click vào ô nào, ô đó viền sáng cam lên cực đẹp */
QLineEdit:focus {
    background-color: #ffffff;
    border: 2.5px solid #E67E22;
}

/* 2. Ô Goal (Mục tiêu) riêng biệt cho nổi bật */
#goalInput {
    background-color: rgba(230, 126, 34, 0.95);
    color: #ffffff;
    font-weight: bold;
    border: 2px solid #D35400;
    border-radius: 8px;
}</string>
