    <height>847</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Công Cụ Tính Điểm GPA - TDLT Midterm</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ==========================================================================
   BRAND BLUE THEME (Clean Blue / Card Layout / Clean and Succinct)
   Main #2D7BF3 | Sub #CCE5FF | White #FFFFFF | Black #16181E
   ========================================================================== */
* {
    font-family: &quot;Inter&quot;, &quot;SF Pro Display&quot;, &quot;SF Pro Text&quot;, &quot;Helvetica Neue&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
    color: #16181E;
}
QMainWindow, QWidget#centralwidget {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #F6F8FB, stop:0.6 #F1F4F9, stop:1 #E6EFFC);
}

/* Cards */
QFrame#card_courses, QFrame#card_scale {
    background-color: #FFFFFF;
    border: 1px solid #E6ECF5;
    border-radius: 26px;
}
QFrame#card_summary {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2D7BF3, stop:0.65 #4A8FF6, stop:1 #7DB1FA);
    border: none;
    border-radius: 30px;
}

/* Header */
QLabel#lbl_header_icon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2D7BF3, stop:1 #6FA8F9);
    border-radius: 16px;
    padding: 12px;
}
QLabel#lbl_header_title { color: #16181E; font-size: 30px; font-weight: 800; }
QLabel#lbl_header_subtitle { color: #8A93A5; font-size: 13px; font-weight: 500; }

/* Table */
QHeaderView { background-color: #FFFFFF; border: none; }
QTableCornerButton::section { background-color: #FFFFFF; border: none; }
QTableWidget#tbl_mon_hoc {
    background-color: #FFFFFF; border: none; gridline-color: transparent;
    selection-background-color: #EAF3FF; selection-color: #16181E; font-size: 13px;
}
QHeaderView::section {
    background-color: #FFFFFF; color: #8A93A5; font-weight: 700; font-size: 12px;
    border: none; border-bottom: 2px solid #EEF2F8; padding: 10px 6px; text-align: left;
}
QTableWidget#tbl_mon_hoc::item { border-bottom: 1px solid #EEF2F8; padding: 4px; }

/* Inputs */
QLineEdit {
    background-color: #FFFFFF; border: 1.5px solid #E1E8F3; border-radius: 10px;
    padding: 6px 12px; font-size: 13px; color: #16181E;
}
QLineEdit:focus { border: 1.5px solid #2D7BF3; background-color: #FAFCFF; }
QLineEdit#txt_gpa_muc_tieu {
    background-color: #FFFFFF; border: 2px solid transparent; border-radius: 22px;
    padding: 6px 18px; font-size: 13px;
}
QLineEdit#txt_gpa_muc_tieu:focus { border: 2px solid #16181E; background-color: #FFFFFF; }

/* Pill switch */
QPushButton#btn_he_10, QPushButton#btn_he_4 {
    border-radius: 18px; font-size: 12px; font-weight: 700; padding: 8px 20px;
    border: 1.5px solid #E1E8F3; background-color: #F4F7FB; color: #4B5565;
}
QPushButton#btn_he_10:hover, QPushButton#btn_he_4:hover { border-color: #2D7BF3; color: #2D7BF3; }
QPushButton#btn_he_10:checked, QPushButton#btn_he_4:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2D7BF3, stop:1 #6FA8F9);
    border-color: #2D7BF3; color: #FFFFFF;
}

/* Action buttons */
QPushButton#btn_them_mon {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2D7BF3, stop:1 #5B9BF8);
    border: none; border-radius: 22px; color: #FFFFFF; font-weight: 700; font-size: 13px;
    padding: 10px 24px 10px 18px;
    text-align: center;
}
QPushButton#btn_them_mon:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1F6BE0, stop:1 #4A8FF6);
}
QPushButton#btn_xoa_mon {
    background-color: #FFFFFF; border: 1.5px solid #E1E8F3; border-radius: 22px;
    color: #16181E; font-weight: 700; font-size: 13px;
    padding: 10px 24px 10px 18px;
    text-align: center;
}
QPushButton#btn_xoa_mon:hover { background-color: #EAF3FF; border-color: #2D7BF3; }

/* Scale chips */
QFrame#scale_box_1, QFrame#scale_box_2, QFrame#scale_box_3, QFrame#scale_box_4,
QFrame#scale_box_5, QFrame#scale_box_6, QFrame#scale_box_7, QFrame#scale_box_8 {
    background-color: #F4F7FB; border: 1px solid #E6ECF5; border-radius: 16px;
}
QFrame#scale_box_1 {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #2D7BF3, stop:1 #5B9BF8);
    border: none;
}

/* Summary card (on blue) */
QLabel#lbl_tieu_de_gpa { color: #FFFFFF; font-size: 15px; font-weight: 700; }
QLabel#lbl_gpa_hien_tai { color: #FFFFFF; font-size: 72px; font-weight: 800; }
QLabel#lbl_trang_thai_gpa {
    color: #FFFFFF; font-size: 15px; font-weight: 700;
    background-color: rgba(255, 255, 255, 50); border: 1px solid rgba(255, 255, 255, 110);
    border-radius: 14px; padding: 6px 18px;
}
QLabel#lbl_dong_vien { color: rgba(255, 255, 255, 225); font-size: 12px; }
QFrame#line_divider_1, QFrame#line_divider_2 {
    background: transparent; border: none; border-top: 1px solid rgba(255, 255, 255, 90); max-height: 1px;
}
QFrame#stat_card_credits, QFrame#stat_card_points, QFrame#stat_card_scale {
    background-color: rgba(255, 255, 255, 238); border: none; border-radius: 18px;
}
QLabel#icon_credits, QLabel#icon_points, QLabel#icon_scale {
    background-color: #CCE5FF; border-radius: 17px; padding: 8px;
}
QLabel#lbl_txt_tong_tin_chi, QLabel#lbl_txt_tong_diem, QLabel#lbl_txt_thang_diem {
    color: #4B5565; font-size: 13px; font-weight: 600;
}
QLabel#lbl_tong_tin_chi, QLabel#lbl_tong_diem, QLabel#lbl_thang_diem {
    color: #16181E; font-size: 16px; font-weight: 800;
}
QLabel#lbl_tieu_de_muc_tieu { color: #FFFFFF; font-size: 13px; font-weight: 700; }
QLabel#lbl_diem_can_dat {
    background-color: #CCE5FF; color: #16181E; font-size: 12px; font-weight: 700;
    border-radius: 16px; padding: 10px 14px;
}

/* Tip bar */
QFrame#frame_tip { background-color: #16181E; border: none; border-radius: 24px; }
QLabel#icon_info { background-color: #2D7BF3; border-radius: 14px; padding: 6px; }
QLabel#lbl_cong_thuc { color: #FFFFFF; font-size: 12px; font-weight: 600; }
</string>
