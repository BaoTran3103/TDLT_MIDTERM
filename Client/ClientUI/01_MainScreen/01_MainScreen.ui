  <property name="styleSheet">
   <string notr="true">/* ==========================================================================
   GLOBAL APP STYLING (Mac Native Typography &amp; Eco Bites Palette)
   Colors: #ADBF15 (Primary Lime), #000000 (Black), #F8F8EB (Cream), #F4A46D (Peach)
   ========================================================================== */

* {
    font-family: "SF Pro Display", "SF Pro Text", "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    color: #111827;
}

QMainWindow, QWidget#centralwidget {
    background-color: #F8F8EB;
}

/* Card Containers */
QFrame#card_courses, QFrame#card_scale, QFrame#card_summary {
    background-color: #FFFFFF;
    border: 1px solid #E5E7D8;
    border-radius: 20px;
}

/* Header Text */
QLabel#lbl_header_title {
    color: #000000;
    font-size: 26px;
    font-weight: 800;
}
QLabel#lbl_header_subtitle {
    color: #6B7280;
    font-size: 13px;
    font-weight: 500;
}

/* Table Widget Styling */
QTableWidget#tbl_mon_hoc {
    background-color: #FFFFFF;
    border: none;
    gridline-color: transparent;
    selection-background-color: #F8F8EB;
    selection-color: #000000;
    font-size: 13px;
}
QTableWidget#tbl_mon_hoc QHeaderView::section {
    background-color: #FFFFFF;
    color: #4B5563;
    font-weight: 700;
    font-size: 12px;
    border: none;
    border-bottom: 2px solid #F3F4F6;
    padding: 10px 4px;
}
QTableWidget#tbl_mon_hoc::item {
    border-bottom: 1px solid #F3F4F6;
    padding: 4px;
}

/* Universal LineEdit */
QLineEdit {
    background-color: #FFFFFF;
    border: 1.5px solid #E5E7EB;
    border-radius: 9px;
    padding: 6px 12px;
    font-size: 13px;
    color: #111827;
}
QLineEdit:focus {
    border: 1.5px solid #ADBF15;
    background-color: #FCFCF7;
}

/* Pill Mode Buttons (Hệ 10 vs Hệ 4) */
QPushButton#btn_he_10, QPushButton#btn_he_4 {
    border-radius: 17px;
    font-size: 12px;
    font-weight: 700;
    padding: 7px 18px;
    border: 1.5px solid #E5E7EB;
    background-color: #FFFFFF;
    color: #4B5563;
}
QPushButton#btn_he_10:hover, QPushButton#btn_he_4:hover {
    border-color: #ADBF15;
    color: #ADBF15;
}
QPushButton#btn_he_10:checked, QPushButton#btn_he_4:checked {
    background-color: #000000;
    border-color: #000000;
    color: #FFFFFF;
}

/* Action Buttons */
QPushButton#btn_them_mon {
    background-color: #FFFFFF;
    border: 1.5px solid #E5E7EB;
    border-radius: 10px;
    color: #1F2937;
    font-weight: 700;
    font-size: 13px;
    padding: 8px 18px;
}
QPushButton#btn_them_mon:hover {
    border: 1.5px solid #ADBF15;
    color: #637007;
    background-color: #F8F8EB;
}
QPushButton#btn_xoa_mon {
    background-color: #FFFFFF;
    border: 1.5px solid #FEE2E2;
    border-radius: 10px;
    color: #DC2626;
    font-weight: 600;
    font-size: 13px;
    padding: 8px 18px;
}
QPushButton#btn_xoa_mon:hover {
    background-color: #FEF2F2;
    border-color: #DC2626;
}

/* Right Card Typography */
QLabel#lbl_tieu_de_gpa {
    color: #111827;
    font-size: 15px;
    font-weight: 700;
}
QLabel#lbl_gpa_hien_tai {
    color: #ADBF15;
    font-size: 64px;
    font-weight: 800;
}
QLabel#lbl_trang_thai_gpa {
    color: #111827;
    font-size: 16px;
    font-weight: 700;
}
QLabel#lbl_dong_vien {
    color: #6B7280;
    font-size: 12px;
}

/* Tip Frame */
QFrame#frame_tip {
    background-color: #F0FDF4;
    border: 1px solid #DCFCE7;
    border-radius: 12px;
}
QLabel#lbl_cong_thuc {
    color: #166534;
    font-size: 12px;
    font-weight: 600;
}
</string>
